+class OffsetEpoca(BaseEstimator, RegressorMixin):
+    """y = f(X) + delta * epoca. La ÚLTIMA columna de X es la época (0/1); f
+    solo ve las demás. Backfitting: f sobre y - delta*e, delta = media del
+    residuo en la época 1. Sin muestras de época 1 en el train, delta = 0."""
+
+    def __init__(self, base=None, max_iter: int = 50, tol: float = 1e-6):
+        self.base, self.max_iter, self.tol = base, max_iter, tol
+
+    def fit(self, X, y):
+        X, y = np.asarray(X, dtype=float), np.asarray(y, dtype=float).ravel()
+        Xb, e = X[:, :-1], X[:, -1]
+        post = e == 1
+        self.delta_ = 0.0
+        self.base_ = clone(self.base).fit(Xb, y)
+        if post.any():
+            for _ in range(self.max_iter):
+                d = float(np.mean(y[post] - _predecir(self.base_, Xb[post])))
+                self.base_ = clone(self.base).fit(Xb, y - d * e)
+                if abs(d - self.delta_) < self.tol:
+                    self.delta_ = d
+                    break
+                self.delta_ = d
+        return self
+
+    def predict(self, X):
+        X = np.asarray(X, dtype=float)
+        return _predecir(self.base_, X[:, :-1]) + self.delta_ * X[:, -1]
+
+
